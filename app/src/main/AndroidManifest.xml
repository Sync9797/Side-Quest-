<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Phone-free sessions: a foreground service watches for unlocks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Daily reminders: ring on time, and come back after a restart. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- A short buzz when a new monster appears nearby. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Loot boxes open by walking: read the phone's step counter. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Optional step source: Health Connect (Samsung Health, Google Fit, Fitbit, ...). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Optional: last night's sleep for the Health card and the morning recap. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Optional: water synced both ways with Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- AI Widget Maker: told when the game changes, so its Monster Quest widgets update. -->
        <package android:name="com.sidequest.widgetmaker" />
        <!-- "Walk here": open walking directions in the phone's map app. -->
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_crest"
        android:roundIcon="@mipmap/ic_crest_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonsterQuest">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.MonsterQuest.Starting"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation|uiMode|colorMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect (Android 13 and older) shows why the game wants step data. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Health Connect (Android 14+) links here from its permission screen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- A read-only summary (eggs, adventures, steps, sleep) for AI Widget Maker's widgets; only that app may read it. -->
        <provider
            android:name=".widget.SummaryProvider"
            android:authorities="com.monsterquest.app.summary"
            android:exported="true" />
        <service
            android:name=".focus.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects when the phone is unlocked during a phone-free focus session the user started." />
        </service>
        <!-- Home-screen widget: reminders, calendar quests and to-dos. -->
        <receiver
            android:name=".widget.QuestWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quest_widget_info" />
        </receiver>
        <!-- Game updates: an adventure back, a rare visitor leaving, an egg ready (alarms set when you leave the game). -->
        <receiver
            android:name=".reminders.NudgeReceiver"
            android:exported="false" />
        <!-- Daily reminders: alarms, notification buttons, and re-arming after a reboot or time change. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
